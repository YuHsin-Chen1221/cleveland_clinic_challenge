# Track only the proposals in docs/ + repo meta; ignore everything else
# (data/, scripts/, challenge statement, notes stay local)
*
!.gitignore
!README.md
!docs/
docs/*
!docs/*.tex
!docs/*.pdf

# LaTeX build artifacts (never track, even under docs/)
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
